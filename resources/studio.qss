/* ============================================================
   ADS1299 Studio — Dark "scientific instrument" stylesheet
   Design tokens (see Theme.h):
     kBg          #0e1116   kSurface     #161b22   kSurfaceAlt  #1c2128
     kBorder      #2d333b   kTextPrimary #e6edf3   kTextMuted   #8b949e
     kAccent      #3fb6ff   kAccentHover #58c4ff   kSignal      #7ee787
     kOk          #3fb950   kWarn        #d29922   kError       #f85149
     kLedOff      #484f58
   ============================================================ */

/* ── Base ───────────────────────────────────────────────────── */
QWidget {
    background-color: #0e1116;
    color: #e6edf3;
    font-family: "-apple-system, Segoe UI, Inter, sans-serif";
    font-size: 13px;
    selection-background-color: #3fb6ff;
    selection-color: #08121a;
}

/* ── Main window & dock widgets ─────────────────────────────── */
QMainWindow {
    background-color: #0e1116;
}

QDockWidget {
    color: #e6edf3;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #161b22;
    color: #8b949e;
    padding: 4px 8px;
    border-bottom: 1px solid #2d333b;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #1c2128;
    border-radius: 3px;
}

/* ── Toolbar ─────────────────────────────────────────────────── */
QToolBar {
    background-color: #161b22;
    border: none;
    spacing: 6px;
    padding: 2px 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #2d333b;
    margin: 4px 2px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e6edf3;
}

QToolButton:hover {
    background-color: #1c2128;
}

QToolButton:pressed {
    background-color: #2d333b;
}

QToolButton:checked {
    background-color: #1c2128;
    color: #3fb6ff;
}

/* ── Push buttons ────────────────────────────────────────────── */
QPushButton {
    background-color: #1c2128;
    border: 1px solid #2d333b;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e6edf3;
}

QPushButton:hover {
    border-color: #3fb6ff;
}

QPushButton:pressed {
    background-color: #2d333b;
}

QPushButton:disabled {
    background-color: #161b22;
    border-color: #2d333b;
    color: #8b949e;
}

/* Primary action button */
QPushButton#primary,
QPushButton[primary="true"] {
    background-color: #3fb6ff;
    border: none;
    color: #08121a;
    font-weight: 600;
}

QPushButton#primary:hover,
QPushButton[primary="true"]:hover {
    background-color: #58c4ff;
}

QPushButton#primary:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #3fb6ff;
    opacity: 0.85;
}

QPushButton#primary:disabled,
QPushButton[primary="true"]:disabled {
    background-color: #2d333b;
    color: #8b949e;
}

/* Record button */
QPushButton#record {
    background-color: #1c2128;
    border: 1px solid #2d333b;
    color: #e6edf3;
}

QPushButton#record:hover {
    border-color: #f85149;
}

QPushButton#record:checked,
QPushButton#record:pressed {
    background-color: #f85149;
    border-color: #f85149;
    color: #ffffff;
}

/* ── Tab widget ──────────────────────────────────────────────── */
QTabWidget::pane {
    border-top: 1px solid #2d333b;
    background-color: #0e1116;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #8b949e;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}

QTabBar::tab:hover {
    color: #e6edf3;
    background-color: #161b22;
}

QTabBar::tab:selected {
    color: #e6edf3;
    border-bottom: 2px solid #3fb6ff;
}

QTabBar::tab:disabled {
    color: #484f58;
}

/* ── Status bar ──────────────────────────────────────────────── */
QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #2d333b;
}

QStatusBar QLabel {
    font-family: "SF Mono, JetBrains Mono, Menlo, monospace";
    font-size: 11px;
    color: #8b949e;
    padding: 0 4px;
}

QStatusBar::item {
    border: none;
}

/* ── Inputs ──────────────────────────────────────────────────── */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #1c2128;
    border: 1px solid #2d333b;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e6edf3;
    selection-background-color: #3fb6ff;
    selection-color: #08121a;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #3fb6ff;
    outline: none;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #161b22;
    color: #8b949e;
    border-color: #2d333b;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1c2128;
    border: 1px solid #2d333b;
    selection-background-color: #3fb6ff;
    selection-color: #08121a;
    outline: none;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 14px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #2d333b;
}

/* ── Group box ───────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #2d333b;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 8px;
    color: #e6edf3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #8b949e;
    font-size: 11px;
}

/* ── Scrollbars ──────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #2d333b;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #2d333b;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484f58;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ── Tooltip ─────────────────────────────────────────────────── */
QToolTip {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #2d333b;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Menu ────────────────────────────────────────────────────── */
QMenu {
    background-color: #1c2128;
    border: 1px solid #2d333b;
    border-radius: 6px;
    padding: 4px 0;
    color: #e6edf3;
}

QMenu::item {
    padding: 6px 20px 6px 12px;
}

QMenu::item:selected {
    background-color: #3fb6ff;
    color: #08121a;
}

QMenu::item:disabled {
    color: #8b949e;
}

QMenu::separator {
    height: 1px;
    background-color: #2d333b;
    margin: 4px 0;
}

/* ── Menu bar ────────────────────────────────────────────────── */
QMenuBar {
    background-color: #161b22;
    color: #e6edf3;
    border-bottom: 1px solid #2d333b;
}

QMenuBar::item {
    padding: 4px 10px;
    background-color: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #1c2128;
    border-radius: 4px;
}

/* ── List & tree views ───────────────────────────────────────── */
QListView,
QTreeView,
QTableView {
    background-color: #0e1116;
    border: 1px solid #2d333b;
    alternate-background-color: #161b22;
    gridline-color: #2d333b;
    outline: none;
}

QListView::item:hover,
QTreeView::item:hover {
    background-color: #161b22;
}

QListView::item:selected,
QTreeView::item:selected {
    background-color: #1c2128;
    color: #3fb6ff;
}

QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-right: 1px solid #2d333b;
    border-bottom: 1px solid #2d333b;
    padding: 4px 8px;
    font-size: 11px;
}

/* ── Progress bar ────────────────────────────────────────────── */
QProgressBar {
    background-color: #1c2128;
    border: 1px solid #2d333b;
    border-radius: 6px;
    text-align: center;
    color: #e6edf3;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #3fb6ff;
    border-radius: 5px;
}

/* ── Slider ──────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #2d333b;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #3fb6ff;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #58c4ff;
}

QSlider::sub-page:horizontal {
    background-color: #3fb6ff;
    border-radius: 2px;
}

/* ── Check box & radio button ────────────────────────────────── */
QCheckBox,
QRadioButton {
    color: #e6edf3;
    spacing: 6px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #8b949e;
}

/* ── Splitter ────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2d333b;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #3fb6ff;
}
